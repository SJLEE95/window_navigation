<Window x:Class="TaskMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskMonitor — 작업 목록" Width="1080" Height="760" MinWidth="720" MinHeight="480"
        FontFamily="{StaticResource UiFont}" FontSize="13" Background="#FAFAFB"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="6" />
            <RowDefinition Height="3*" MinHeight="200" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="상태 폴더 열기" Click="OpenStateFolder_Click" Padding="10,3" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="#666" TextTrimming="CharacterEllipsis">
                <Run Text="작업 상태 폴더:" />
                <Run x:Name="StateDirRun" Text="" />
                <Run x:Name="ErrorRun" Text="" Foreground="#C62828" />
            </TextBlock>
        </DockPanel>

        <!-- 작업 목록: 상태 | 작업 이름 | 현재 단계 | 진행률 | 예상 완료 시각 -->
        <ListView Grid.Row="1" x:Name="List" ItemsSource="{Binding Items}" SelectionMode="Single"
                  SelectionChanged="List_SelectionChanged" BorderBrush="#DDD">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="2,3" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="상태" Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" Background="{Binding Brush}" CornerRadius="2" Margin="0,0,6,0" />
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding V.Symbol, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}" />
                                        <Run Text="{Binding V.StatusLabel, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="작업 이름" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding V.Id}">
                                    <Run Text="{Binding V.Name, Mode=OneWay}" />
                                    <Run Text="{Binding V.Project, Mode=OneWay}" Foreground="#888" FontSize="11" />
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="현재 단계" Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding V.StageText}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="진행률" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ProgressBar Height="16" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                                 Foreground="{Binding Brush}" Background="#EEE" BorderThickness="0"
                                                 Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" Opacity="0.35" />
                                    <TextBlock Text="{Binding V.ProgressText}" Margin="4,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="예상 완료 시각" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding V.EtaShort}" ToolTip="예상값입니다 (≈)" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- 선택한 작업 상세 -->
        <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" Background="White" CornerRadius="3">
            <Grid>
                <TextBlock x:Name="EmptyHint" Text="목록에서 작업을 선택하세요." Foreground="#888" Margin="14" />
                <ScrollViewer x:Name="Detail" VerticalScrollBarVisibility="Auto" Padding="14,10" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="{Binding Brush}" CornerRadius="3" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Foreground="White" FontWeight="SemiBold">
                                    <Run Text="{Binding V.Symbol, Mode=OneWay}" />
                                    <Run Text="{Binding V.StatusLabel, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding V.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding ProjectLine}" Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding V.Message}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding V.TimesText}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding V.UpdatedText}" />

                        <Border Background="#FFF8E1" BorderBrush="#E3B341" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,8,0,0"
                                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding WarningsText}" TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="현재 단계 예상 완료: " Foreground="#555" />
                            <TextBlock Grid.Column="1" Text="{Binding V.StageEtaText}" />
                            <TextBlock Grid.Row="1" Text="전체 작업 예상 완료: " Foreground="#555" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding V.OverallEtaText}" />
                            <TextBlock Grid.Row="2" Text="전체 진행률: " Foreground="#555" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding V.OverallProgressText}" />
                        </Grid>
                        <TextBlock Text="≈ 표시는 지금까지의 처리 속도로 계산한 예상값입니다. 이후 단계 소요 시간을 모르면 전체 ETA는 '정보 부족'으로 표시합니다."
                                   Foreground="#999" FontSize="11" TextWrapping="Wrap" />

                        <StackPanel Visibility="{Binding HasWaiting, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="대기 / 선행 작업" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding V.WaitingText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="단계" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding V.Stages}" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SName" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SAmount" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SRate" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Index}" Foreground="#888" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="0,0,14,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2">
                                            <Run Text="{Binding Symbol, Mode=OneWay}" />
                                            <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding Amount}" Margin="0,0,14,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding RateText}" Margin="0,0,14,0" Foreground="#555" />
                                        <Grid Grid.Column="5" Margin="0,0,10,0">
                                            <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}" Opacity="0.4" />
                                            <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Center" FontSize="11" />
                                        </Grid>
                                        <TextBlock Grid.Column="6" Text="{Binding TimeText}" Foreground="#777" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="오류" Style="{StaticResource SectionTitle}" Foreground="#C62828" />
                            <TextBox Text="{Binding V.ErrorText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" Background="#FFF5F5" BorderBrush="#F5C2C2"
                                     MaxHeight="180" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <TextBlock Text="결과" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="NoResults" Text="기록된 결과 경로 없음" Foreground="#888" />
                        <ItemsControl ItemsSource="{Binding V.Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <Button DockPanel.Dock="Right" Content="폴더 열기" Click="OpenResultFolder_Click" Tag="{Binding Path}" Padding="8,1" Margin="4,0,0,0" />
                                        <Button DockPanel.Dock="Right" Content="열기" Click="OpenResult_Click" Tag="{Binding Path}" Padding="8,1" Margin="4,0,0,0"
                                                IsEnabled="{Binding Exists}" />
                                        <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}">
                                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Note, Mode=OneWay}" Foreground="#C62828" />
                                            <Run Text="{Binding Path, Mode=OneWay}" Foreground="#666" />
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding V.CompletionText}" Foreground="#666" Margin="0,4,0,0" />

                        <TextBlock Style="{StaticResource SectionTitle}">
                            <Run Text="최근 로그" />
                            <Run x:Name="LogPathRun" Text="" Foreground="#888" FontWeight="Normal" />
                        </TextBlock>
                        <TextBlock x:Name="LogErrors" Foreground="#C62828" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 Height="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="#1E1F22" Foreground="#D7DAE0" BorderThickness="0" Padding="6" />

                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="BtnOpenResult" Content="결과 파일 열기" Click="OpenFirstResult_Click" Style="{StaticResource FlatButton}" />
                            <Button x:Name="BtnOpenFolder" Content="결과 폴더 열기" Click="OpenFirstFolder_Click" Style="{StaticResource FlatButton}" />
                            <Button x:Name="BtnOpenLog" Content="전체 로그 열기" Click="OpenLog_Click" Style="{StaticResource FlatButton}" />
                            <Button x:Name="BtnWorkdir" Content="작업 디렉터리" Click="OpenWorkdir_Click" Style="{StaticResource FlatButton}" />
                            <Button x:Name="BtnCancel" Content="중단 요청" Click="Cancel_Click" Style="{StaticResource FlatButton}" />
                            <Button x:Name="BtnArchive" Content="목록에서 숨기기" Click="Archive_Click" Style="{StaticResource FlatButton}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding V.CancelText}" Foreground="#666" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
