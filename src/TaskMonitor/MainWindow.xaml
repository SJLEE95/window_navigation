<Window x:Class="TaskMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskMonitor"
        Title="TaskMonitor" Width="1200" Height="820" MinWidth="860" MinHeight="520"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Ink}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <local:KindBrushConverter x:Key="KindBrush" />
        <local:NullableToNaNConverter x:Key="NaN" />
        <local:NonEmptyToVisConverter x:Key="NonEmptyToVis" />

        <!-- 작업 카드 목록 항목 -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23262E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardSelBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A5260" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 위치 고르기 버튼 -->
        <Style x:Key="SegButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource RaisedBg}" BorderBrush="{StaticResource LineStrong}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C313B" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25324A" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 사이드바 -->
        <Border Background="{StaticResource SidebarBg}" BorderBrush="#23262E" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,14,0,14">
                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Width="44" Height="44" Padding="0"
                        Click="ExitMonitor_Click" ToolTip="모니터 종료 (실행 중인 작업은 계속 돕니다)">
                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource Muted}" />
                </Button>
                <StackPanel>
                    <RadioButton x:Name="NavTasks" Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True"
                                 Checked="Nav_Checked" Tag="tasks" ToolTip="작업" Margin="0,0,0,8">
                        <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="18" />
                    </RadioButton>
                    <RadioButton x:Name="NavShortcuts" Style="{StaticResource NavButton}" GroupName="nav"
                                 Checked="Nav_Checked" Tag="shortcuts" ToolTip="바로가기" Margin="0,0,0,8">
                        <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="18" />
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="nav"
                                 Checked="Nav_Checked" Tag="settings" ToolTip="설정">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18" />
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================== 작업 ============================== -->
        <Grid x:Name="PageTasks" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="22,20,12,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="작업" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource Muted}" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="LastErrorText" Foreground="#FF8FA3" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="Collapsed" />
                <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectionMode="Single" SelectionChanged="List_SelectionChanged"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CardItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Opacity="{Binding CardOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="52" Height="52" VerticalAlignment="Center">
                                    <local:Ring Value="{Binding RingValue}" Stroke="{Binding Brush}" Track="#2F343E" Thickness="5" />
                                    <TextBlock Text="{Binding RingText}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CardTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CardLine2}" Foreground="{Binding Brush}" FontSize="12" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CardLine3}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- 상세 -->
            <Border Grid.Column="2" Margin="6,20,20,20" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="14">
                <Grid>
                    <TextBlock x:Name="EmptyHint" Text="왼쪽에서 작업을 고르세요." Foreground="{StaticResource Muted}" Margin="24" />
                    <ScrollViewer x:Name="Detail" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Collapsed"
                                  PreviewMouseWheel="Detail_PreviewMouseWheel">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{Binding Brush}" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding V.StatusLabel}" Foreground="#0C0D10" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding ProjectLine}" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding V.Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding V.Message}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap">
                                <Run Text="{Binding V.TimesText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding V.UpdatedText, Mode=OneWay}" />
                            </TextBlock>

                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="BtnOpenFolder" Content="결과 폴더 열기" Style="{StaticResource PrimaryButton}" Click="OpenFirstFolder_Click" />
                                <Button x:Name="BtnOpenResult" Content="결과 파일 열기" Style="{StaticResource DarkButton}" Click="OpenFirstResult_Click" />
                                <Button x:Name="BtnOpenLog" Content="전체 로그" Style="{StaticResource DarkButton}" Click="OpenLog_Click" />
                                <Button x:Name="BtnWorkdir" Content="작업 폴더" Style="{StaticResource DarkButton}" Click="OpenWorkdir_Click" />
                                <Button x:Name="BtnCancel" Content="중단 요청" Style="{StaticResource DarkButton}" Click="Cancel_Click" />
                                <Button x:Name="BtnArchive" Content="목록에서 숨기기" Style="{StaticResource DarkButton}" Click="Archive_Click" />
                            </WrapPanel>
                            <TextBlock Text="{Binding V.CancelText}" Foreground="#6C7280" FontSize="12" />

                            <!-- 자동 감지 정보 -->
                            <Border Background="#1A2233" CornerRadius="10" Padding="12,10" Margin="0,12,0,0"
                                    Visibility="{Binding V.IsAuto, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding V.ActivityText}" Foreground="#AFC8FF" FontSize="12" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding V.CommandLine, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Foreground="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                             TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 경고 -->
                            <Border Background="{x:Static local:Theme.WarningBg}" CornerRadius="10" Padding="12,10" Margin="0,12,0,0"
                                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding WarningsText}" Foreground="#F2C66D" TextWrapping="Wrap" />
                            </Border>

                            <!-- 핵심 수치 -->
                            <UniformGrid Columns="3" Margin="0,14,0,0">
                                <Border Background="{StaticResource RaisedBg}" CornerRadius="10" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="현재 단계 예상 완료" Foreground="{StaticResource Muted}" FontSize="12" />
                                        <TextBlock Text="{Binding V.StageEtaText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource RaisedBg}" CornerRadius="10" Padding="14,12" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="처리량" Foreground="{StaticResource Muted}" FontSize="12" />
                                        <TextBlock Text="{Binding CurrentAmount}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CurrentRate}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource RaisedBg}" CornerRadius="10" Padding="14,12" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="전체 예상 완료" Foreground="{StaticResource Muted}" FontSize="12" />
                                        <TextBlock Text="{Binding V.OverallEtaText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding V.OverallProgressText}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="≈ 는 지금까지의 처리 속도로 계산한 예상값입니다." Foreground="#6C7280" FontSize="11" Margin="0,6,0,0" />

                            <StackPanel Visibility="{Binding HasWaiting, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="대기 · 선행 작업" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding V.WaitingText}" TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Text="단계" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding V.Stages}" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SName" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SState" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="SAmount" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <local:Ring Width="18" Height="18" Thickness="3" Track="#2F343E" HorizontalAlignment="Left"
                                                        Value="{Binding Percent, Converter={StaticResource NaN}}"
                                                        Stroke="{Binding Kind, Converter={StaticResource KindBrush}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Margin="0,0,16,0" VerticalAlignment="Center"
                                                       Foreground="{Binding Kind, Converter={StaticResource KindBrush}}" />
                                            <TextBlock Grid.Column="3" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Run Text="{Binding Amount, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding PercentText, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="4" Text="{Binding TimeText}" Foreground="{StaticResource Muted}" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="오류" Style="{StaticResource SectionTitle}" Foreground="#FF8FA3" />
                                <TextBox Text="{Binding V.ErrorText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180"
                                         VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         Background="{x:Static local:Theme.FailedBg}" Foreground="#FFC2CD" BorderThickness="0" Padding="10,8" />
                            </StackPanel>

                            <TextBlock Text="결과" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="NoResults" Text="기록된 결과 경로 없음" Foreground="#6C7280" />
                            <ItemsControl ItemsSource="{Binding V.Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="위치" Style="{StaticResource DarkButton}" Padding="10,3" Margin="6,0,0,0"
                                                    Click="OpenResultFolder_Click" Tag="{Binding Path}" />
                                            <Button DockPanel.Dock="Right" Content="열기" Style="{StaticResource DarkButton}" Padding="10,3" Margin="6,0,0,0"
                                                    Click="OpenResult_Click" Tag="{Binding Path}" IsEnabled="{Binding Exists}" />
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}">
                                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Note, Mode=OneWay}" Foreground="#FF8FA3" />
                                                <Run Text="{Binding Path, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding V.CompletionText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="최근 로그" /><Run x:Name="LogPathRun" Text="" Foreground="#6C7280" FontWeight="Normal" />
                            </TextBlock>
                            <TextBlock x:Name="LogErrors" Foreground="#FF8FA3" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}"
                                       FontSize="12" Margin="0,0,0,6" Visibility="Collapsed" />
                            <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" Height="220"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="#121418" Foreground="#C9CED8" BorderThickness="0" Padding="10,8" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================== 바로가기 ============================== -->
        <DockPanel x:Name="PageShortcuts" Grid.Column="1" Margin="26,20,26,20" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="바로가기" FontSize="22" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="캡슐의 ‘앱’ 버튼에서 펼쳐지는 바로가기입니다. 파일·폴더·.lnk 를 캡슐이나 이 창에 끌어다 놓아도 추가됩니다. 이름과 인자는 고친 뒤 다른 곳을 누르면 저장됩니다." />
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button Content="파일·앱 추가…" Style="{StaticResource PrimaryButton}" Click="AddFile_Click" />
                <Button Content="폴더 추가…" Style="{StaticResource DarkButton}" Click="AddFolder_Click" />
                <TextBox x:Name="UrlBox" Style="{StaticResource DarkTextBox}" Width="320" Margin="12,0,6,6" VerticalContentAlignment="Center"
                         ToolTip="https:// 로 시작하는 웹 주소" />
                <Button Content="웹 주소 추가" Style="{StaticResource DarkButton}" Click="AddUrl_Click" />
                <CheckBox Content="패널을 열어 둔 채로 (실행해도 닫지 않음)" IsChecked="{Binding Shortcuts.Pinned}" Style="{StaticResource DarkCheck}"
                          VerticalAlignment="Center" Margin="16,0,0,6" />
            </WrapPanel>
            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"
                    AllowDrop="True" DragEnter="Shortcuts_DragEnter" DragOver="Shortcuts_DragEnter" Drop="Shortcuts_Drop">
                <Grid>
                    <TextBlock x:Name="ShortcutsEmpty" Text="아직 바로가기가 없습니다. 파일·폴더를 여기로 끌어다 놓아 보세요."
                               Foreground="{StaticResource Muted}" Margin="20" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl ItemsSource="{Binding Shortcuts.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" CornerRadius="10" Padding="10,8" Margin="0,0,0,2" Opacity="{Binding Opacity}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="32" Height="32" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                <Border CornerRadius="8" Background="#5B5BD6" Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkTextBox}" />
                                                <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding PathText}" Foreground="{StaticResource Muted}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}" />
                                                <DockPanel Margin="0,4,0,0" Visibility="{Binding CanEditArgs, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="인자" Foreground="#6C7280" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBox Text="{Binding Args, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkTextBox}" FontSize="12" />
                                                </DockPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="실행" Style="{StaticResource DarkButton}" Padding="10,4" Margin="0,0,4,0"
                                                        Click="ShortcutRun_Click" Tag="{Binding}" />
                                                <Button Content="위치" Style="{StaticResource DarkButton}" Padding="10,4" Margin="0,0,4,0"
                                                        Click="ShortcutReveal_Click" Tag="{Binding}" />
                                                <Button Content="▲" Style="{StaticResource DarkButton}" Padding="8,4" Margin="0,0,4,0"
                                                        Click="ShortcutUp_Click" Tag="{Binding}" ToolTip="앞으로" />
                                                <Button Content="▼" Style="{StaticResource DarkButton}" Padding="8,4" Margin="0,0,4,0"
                                                        Click="ShortcutDown_Click" Tag="{Binding}" ToolTip="뒤로" />
                                                <Button Content="제거" Style="{StaticResource DarkButton}" Padding="10,4" Margin="0"
                                                        Click="ShortcutRemove_Click" Tag="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </DockPanel>

        <!-- ============================== 설정 ============================== -->
        <ScrollViewer x:Name="PageSettings" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,20,26,20" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="설정" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

                <TextBlock Text="캡슐 위치" Style="{StaticResource SectionTitle}" />
                <UniformGrid x:Name="PlacementGrid" Columns="3" Width="480" HorizontalAlignment="Left">
                    <RadioButton Style="{StaticResource SegButton}" GroupName="pos" Tag="TopLeft" Content="왼쪽 위" Checked="Placement_Checked" />
                    <RadioButton Style="{StaticResource SegButton}" GroupName="pos" Tag="TopCenter" Content="위 가운데" Checked="Placement_Checked" />
                    <RadioButton Style="{StaticResource SegButton}" GroupName="pos" Tag="TopRight" Content="오른쪽 위" Checked="Placement_Checked" />
                    <RadioButton Style="{StaticResource SegButton}" GroupName="pos" Tag="BottomLeft" Content="왼쪽 아래" Checked="Placement_Checked" />
                    <RadioButton Style="{StaticResource SegButton}" GroupName="pos" Tag="BottomCenter" Content="아래 가운데" Checked="Placement_Checked" />
                    <RadioButton Style="{StaticResource SegButton}" GroupName="pos" Tag="BottomRight" Content="오른쪽 아래" Checked="Placement_Checked" />
                </UniformGrid>
                <TextBlock Text="캡슐의 빈 곳을 끌어 놓아도 가장 가까운 자리로 붙습니다." Foreground="#6C7280" FontSize="12" Margin="0,6,0,0" />

                <TextBlock Text="동작" Style="{StaticResource SectionTitle}" />
                <CheckBox x:Name="ChkTopmost" Content="캡슐을 항상 위에 표시" Style="{StaticResource DarkCheck}" Click="Setting_Click" />
                <CheckBox x:Name="ChkFullscreen" Content="다른 프로그램이 전체 화면이면 캡슐 숨기기" Style="{StaticResource DarkCheck}" Click="Setting_Click" />
                <CheckBox x:Name="ChkAuto" Content="실행 중인 Python 작업 자동 감지 (상태 기록 없는 작업도 표시)" Style="{StaticResource DarkCheck}" Click="Setting_Click" />
                <CheckBox x:Name="ChkAutostart" Content="Windows 시작 시 실행" Style="{StaticResource DarkCheck}" Click="Setting_Click" />

                <TextBlock Text="상태 폴더" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="StateDirText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="상태 폴더 열기" Style="{StaticResource DarkButton}" Click="OpenStateFolder_Click" />
                    <Button Content="모니터 종료" Style="{StaticResource DarkButton}" Click="ExitMonitor_Click"
                            ToolTip="모니터만 끕니다. 실행 중인 작업은 계속 돕니다." />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
