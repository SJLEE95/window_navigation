<Window x:Class="TaskMonitor.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskMonitor"
        Title="TaskMonitor 바"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- 그림자 여백 -->
    <Grid Margin="8,6,8,12">
        <Border x:Name="Root" Background="{StaticResource CapsuleBg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="22" Padding="6,0" Height="44" AllowDrop="True"
                MouseLeftButtonDown="Root_MouseLeftButtonDown" DragEnter="Root_DragEnter" DragOver="Root_DragEnter" Drop="Root_Drop">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#000000" />
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu x:Name="Menu" Opened="Menu_Opened">
                    <MenuItem Header="작업 창 열기" Click="OpenMain_Click" FontWeight="SemiBold" />
                    <MenuItem Header="바로가기 관리" Click="ManageShortcuts_Click" />
                    <Separator />
                    <MenuItem Header="위치">
                        <MenuItem x:Name="PosTopCenter" Header="위 가운데" Tag="TopCenter" Click="Placement_Click" IsCheckable="True" />
                        <MenuItem x:Name="PosTopLeft" Header="왼쪽 위" Tag="TopLeft" Click="Placement_Click" IsCheckable="True" />
                        <MenuItem x:Name="PosTopRight" Header="오른쪽 위" Tag="TopRight" Click="Placement_Click" IsCheckable="True" />
                        <MenuItem x:Name="PosBottomCenter" Header="아래 가운데 (작업 표시줄 위)" Tag="BottomCenter" Click="Placement_Click" IsCheckable="True" />
                        <MenuItem x:Name="PosBottomLeft" Header="왼쪽 아래" Tag="BottomLeft" Click="Placement_Click" IsCheckable="True" />
                        <MenuItem x:Name="PosBottomRight" Header="오른쪽 아래" Tag="BottomRight" Click="Placement_Click" IsCheckable="True" />
                    </MenuItem>
                    <MenuItem x:Name="MiTopmost" Header="항상 위에 표시" IsCheckable="True" Click="Topmost_Click" />
                    <MenuItem x:Name="MiFullscreen" Header="다른 프로그램이 전체 화면이면 숨기기" IsCheckable="True" Click="Fullscreen_Click" />
                    <MenuItem x:Name="MiAuto" Header="실행 중인 Python 작업 자동 감지" IsCheckable="True" Click="Auto_Click" />
                    <MenuItem x:Name="MiAutostart" Header="Windows 시작 시 실행" IsCheckable="True" Click="Autostart_Click" />
                    <Separator />
                    <MenuItem Header="모니터 종료 (작업은 계속 실행됨)" Click="Exit_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 바로가기 패널 열기 -->
                <Button x:Name="AppsButton" Style="{StaticResource GhostButton}" Background="#22262E" Height="32" Padding="8,0,12,0"
                        Click="AppsButton_Click" ToolTip="바로가기 (파일·폴더를 여기로 끌어다 놓으면 추가)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Shortcuts.CountText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="20" Fill="{StaticResource Line}" Margin="8,0" />

                <TextBlock Text="작업 없음" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,8,0"
                           Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Chips}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="Chip_Click" Tag="{Binding TaskId}" ToolTip="{Binding Tooltip}" Height="32" Margin="1,0"
                                    Style="{StaticResource GhostButton}">
                                <Grid>
                                    <!-- 진행 링 -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsRing, Converter={StaticResource BoolToVis}}">
                                        <local:Ring Width="22" Height="22" Thickness="3" Value="{Binding Ring}" Stroke="{Binding Brush}"
                                                    Track="#2A2E37" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                            <Run Text="{Binding Sub, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Eta}" Foreground="{Binding Brush}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- 경고·실패 알약 -->
                                    <Border Visibility="{Binding IsPill, Converter={StaticResource BoolToVis}}" Background="{Binding PillBg}"
                                            CornerRadius="15" Height="30" Padding="10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{Binding Brush}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding PillText}" Foreground="{Binding Brush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Overflow}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0" />

                <Button Style="{StaticResource GhostButton}" Width="32" Height="32" Padding="0" Click="OpenMain_Click" ToolTip="작업 창">
                    <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
            </StackPanel>
        </Border>

        <!-- 바로가기 패널 (캡슐에서 펼쳐짐) -->
        <Popup x:Name="AppsPopup" PlacementTarget="{Binding ElementName=AppsButton}" Placement="Bottom" VerticalOffset="10"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Background="{StaticResource CapsuleBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16"
                    Padding="14" Width="324" Margin="0,0,12,16" AllowDrop="True"
                    DragEnter="Root_DragEnter" DragOver="Root_DragEnter" Drop="Root_Drop">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.6" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="2,0,0,10">
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Shortcuts.Pinned}" Cursor="Hand" Focusable="False"
                                      ToolTip="열어 둔 채로 고정" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}">
                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        </ToggleButton>
                        <TextBlock Text="바로가기" Foreground="{StaticResource Muted}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Shortcuts.Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButton}" Height="80" Margin="3" Click="Shortcut_Click" Tag="{Binding}"
                                        ToolTip="{Binding Tooltip}" Opacity="{Binding Opacity}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="열기" Click="ShortcutOpen_Click" Tag="{Binding}" FontWeight="SemiBold" />
                                            <MenuItem Header="파일 위치 열기" Click="ShortcutReveal_Click" Tag="{Binding}" />
                                            <MenuItem Header="이름·인자 편집" Click="ManageShortcuts_Click" />
                                            <Separator />
                                            <MenuItem Header="앞으로 이동" Click="ShortcutLeft_Click" Tag="{Binding}" />
                                            <MenuItem Header="뒤로 이동" Click="ShortcutRight_Click" Tag="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="제거" Click="ShortcutRemove_Click" Tag="{Binding}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel>
                                        <Grid Width="32" Height="32" HorizontalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                            <Border CornerRadius="8" Background="#5B5BD6" Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" Margin="0,8,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="86" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 추가 타일 -->
                    <Button Style="{StaticResource TileButton}" Background="Transparent" BorderBrush="#3A3F4A" BorderThickness="1"
                            Height="40" Margin="3,6,3,0" Click="AddShortcut_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AddMenu">
                                <MenuItem Header="파일·앱(.exe·.lnk) 추가…" Click="AddFile_Click" />
                                <MenuItem Header="폴더 추가…" Click="AddFolder_Click" />
                                <MenuItem Header="바로가기 관리 (웹 주소 추가)" Click="ManageShortcuts_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="추가" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
