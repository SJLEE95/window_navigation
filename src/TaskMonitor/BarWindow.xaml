<Window x:Class="TaskMonitor.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskMonitor 바"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border x:Name="Root" Background="#F01B1E23" BorderBrush="#40FFFFFF" BorderThickness="1"
            CornerRadius="6" Padding="2,3" MinHeight="28">
        <Border.ContextMenu>
            <ContextMenu x:Name="Menu" Opened="Menu_Opened">
                <MenuItem Header="작업 목록·상세 창 열기" Click="OpenMain_Click" FontWeight="SemiBold" />
                <Separator />
                <MenuItem Header="위치">
                    <MenuItem x:Name="PosTopRight" Header="오른쪽 위 귀퉁이" Tag="TopRight" Click="Placement_Click" IsCheckable="True" />
                    <MenuItem x:Name="PosTopLeft" Header="왼쪽 위 귀퉁이" Tag="TopLeft" Click="Placement_Click" IsCheckable="True" />
                    <MenuItem x:Name="PosBottomRight" Header="오른쪽 아래 귀퉁이 (작업 표시줄 위)" Tag="BottomRight" Click="Placement_Click" IsCheckable="True" />
                    <MenuItem x:Name="PosBottomLeft" Header="왼쪽 아래 귀퉁이 (작업 표시줄 위)" Tag="BottomLeft" Click="Placement_Click" IsCheckable="True" />
                    <Separator />
                    <MenuItem x:Name="PosDockTop" Header="화면 위쪽에 고정 (공간 예약, 다른 창이 가리지 않음)" Tag="DockTop" Click="Placement_Click" IsCheckable="True" />
                    <MenuItem x:Name="PosDockBottom" Header="화면 아래쪽에 고정 (공간 예약)" Tag="DockBottom" Click="Placement_Click" IsCheckable="True" />
                </MenuItem>
                <MenuItem x:Name="MiTopmost" Header="항상 위에 표시" IsCheckable="True" Click="Topmost_Click" />
                <MenuItem x:Name="MiFullscreen" Header="다른 프로그램이 전체 화면이면 숨기기" IsCheckable="True" Click="Fullscreen_Click" />
                <MenuItem x:Name="MiRecent" Header="최근 완료 작업도 표시" IsCheckable="True" Click="Recent_Click" />
                <MenuItem x:Name="MiAuto" Header="실행 중인 Python 작업 자동 감지" IsCheckable="True" Click="Auto_Click" />
                <MenuItem x:Name="MiAutostart" Header="Windows 시작 시 실행" IsCheckable="True" Click="Autostart_Click" />
                <Separator />
                <MenuItem Header="상태 폴더 열기" Click="OpenFolder_Click" />
                <MenuItem Header="모니터 종료 (작업은 계속 실행됨)" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <DockPanel LastChildFill="False">
            <!-- 끌어서 옮기기 손잡이 (놓으면 가까운 귀퉁이에 붙음) -->
            <TextBlock DockPanel.Dock="Left" Text="⋮⋮" Foreground="#80FFFFFF" Margin="4,0,4,0" VerticalAlignment="Center"
                       Cursor="SizeAll" MouseLeftButtonDown="Handle_MouseDown" ToolTip="끌어서 위치 이동 · 우클릭: 설정" />
            <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Summary}" VerticalAlignment="Center" Margin="0,0,6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}" Margin="2,0,6,0" FontWeight="SemiBold" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button DockPanel.Dock="Left" Style="{StaticResource ChipButton}" Click="OpenMain_Click" ToolTip="작업 목록·상세 창">
                <TextBlock Text="≡ 목록" Foreground="#E6EDF3" />
            </Button>
            <Rectangle DockPanel.Dock="Left" Width="1" Fill="#40FFFFFF" Margin="0,2,4,2" />
            <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Chips}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButton}" Click="Chip_Click" Tag="{Binding TaskId, Mode=OneWay}" MaxWidth="280"
                                ToolTip="{Binding Tooltip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Background="{Binding Brush, Mode=OneWay}" CornerRadius="1" Margin="0,1,6,1" />
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Symbol, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}" />
                                    <Run Text="{Binding Label, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Text, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Overflow, Mode=OneWay}" Foreground="#B0FFFFFF" Margin="4,0" VerticalAlignment="Center" />
        </DockPanel>
    </Border>
</Window>
